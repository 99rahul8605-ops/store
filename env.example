# Copy to .env for local tests only; set as PRIVATE Railway variables in production.
BOT_TOKEN=NEW_BOTFATHER_TOKEN
BOT_OWNER_ID=123456789
MONGODB_URI=mongodb+srv://BOT_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bingolink_filebot
BINGOLINK_API_KEY=bl_live_YOUR_BINGOLINK_BOT_ACCOUNT_KEY
BINGOLINK_BASE_URL=https://www.bingolink.site
